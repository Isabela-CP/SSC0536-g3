# API real é o padrão. Use mock explicitamente quando precisar dos fixtures.
VITE_API_MODE=real
VITE_API_BASE_URL=/api
# Proxy do servidor de desenvolvimento (não é exposto no bundle).
OTO_API_TARGET=http://127.0.0.1:8000
# Opcional: Bearer obtido no backend local. Não use prefixo VITE_ nesta variável.
OTO_DEV_BEARER_TOKEN=
# Deve acompanhar OTO_UPLOAD_MAX_BYTES do backend.
VITE_UPLOAD_MAX_BYTES=10485760
